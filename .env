# =============================================================================
# Home SOC Lab — Environment Variables
# =============================================================================
# This file is loaded by docker compose. Change values BEFORE first boot.
# After changing passwords, you must also update internal Wazuh stores —
# see: https://documentation.wazuh.com/current/user-manual/user-administration/
# =============================================================================

# --- Wazuh Version -----------------------------------------------------------
WAZUH_VERSION=4.9.2

# --- Indexer (OpenSearch) Credentials ----------------------------------------
# Used by filebeat on the manager and the dashboard to authenticate to indexer.
INDEXER_USERNAME=admin
INDEXER_PASSWORD=admin

# --- Dashboard Credentials ---------------------------------------------------
# Internal user for dashboard ↔ indexer communication.
DASHBOARD_USERNAME=kibanaserver
DASHBOARD_PASSWORD=kibanaserver

# --- Wazuh API Credentials ---------------------------------------------------
# Used by the dashboard to call the Wazuh Manager REST API.
API_USERNAME=wazuh-wui
API_PASSWORD=MyS3cr3tP4ssw0rd!

# --- Cluster Encryption Key --------------------------------------------------
# 32-character hex key for inter-node cluster encryption.
# Must be identical on all cluster nodes (single-node lab: leave as-is).
WAZUH_CLUSTER_KEY=01234567890123456789012345678901

# --- AWS Integration (Optional) ----------------------------------------------
# Populate these if you have AWS CloudTrail / GuardDuty logs in S3.
# Then enable the <wodle name="aws-s3"> block in ossec.conf.
AWS_CLOUDTRAIL_BUCKET=your-cloudtrail-bucket
AWS_GUARDDUTY_BUCKET=your-guardduty-bucket
